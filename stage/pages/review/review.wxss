.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f2ec;
}

.content {
  flex: 1;
  overflow: hidden;
  padding-top: 20rpx;
}

.card {
  margin: 0 24rpx 20rpx;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(78, 51, 32, 0.05);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f6efe6;
}

.order-no {
  font-size: 21rpx;
  color: #a89484;
  letter-spacing: 1rpx;
}

.order-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #ef5a24;
}

.order-dishes {
  margin-top: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #3a2b20;
  line-height: 1.6;
}

.order-table {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a89484;
}

.rating-card {
  padding: 34rpx 26rpx;
  text-align: center;
}

.rating-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f241d;
}

.star-row {
  margin-top: 26rpx;
  display: flex;
  justify-content: center;
}

.star {
  width: 84rpx;
  font-size: 64rpx;
  line-height: 1;
  color: #e6d3c2;
  transition: color 0.15s;
}

.star.active {
  color: #ff8a3d;
}

.rating-label {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #a06a44;
  font-weight: 600;
}

.review-input {
  width: 100%;
  height: 220rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3a2b20;
}

.review-placeholder {
  color: #b5a292;
}

.input-count {
  text-align: right;
  font-size: 20rpx;
  color: #b5a292;
}

.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #3a2b20;
}

.switch-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #a89484;
}

.tip {
  margin: 0 34rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a89484;
}

.bottom-gap {
  height: 160rpx;
}

.submit-bar {
  flex-shrink: 0;
  padding: 18rpx 28rpx;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(78, 51, 32, 0.07);
}

.submit-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff8659, #ef5a24);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(239, 90, 36, 0.26);
}

.submit-btn.loading {
  opacity: 0.6;
}

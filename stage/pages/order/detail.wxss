.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f2ec;
}

.content {
  flex: 1;
  overflow: hidden;
}

.status-hero {
  padding: 46rpx 32rpx 54rpx;
  background: linear-gradient(135deg, #ff8659, #e8531d);
  color: #ffffff;
}

.status-hero.finished {
  background: linear-gradient(135deg, #8aa88f, #5f7d67);
}

.status-hero.cancelled {
  background: linear-gradient(135deg, #9c948c, #7a7370);
}

.status-title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.status-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

.card {
  margin: 20rpx 24rpx 0;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(78, 51, 32, 0.05);
}

.flow-card {
  margin-top: -30rpx;
  position: relative;
}

.steps {
  display: flex;
  align-items: flex-start;
}

.step {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f1e8dd;
  color: #b5a292;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.step.done .step-dot {
  background: linear-gradient(135deg, #ff8659, #ef5a24);
  color: #ffffff;
}

.step-line {
  position: absolute;
  top: 22rpx;
  left: 50%;
  width: 100%;
  height: 2rpx;
  background: #f1e8dd;
  z-index: 1;
}

.step-line.done {
  background: #f3b492;
}

.step-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #a89484;
  text-align: center;
  white-space: nowrap;
}

.step.done .step-label {
  color: #3a2b20;
  font-weight: 600;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f241d;
}

.card-sub {
  font-size: 22rpx;
  color: #a89484;
}

.dish-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.dish-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0e5d8;
}

.dish-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.dish-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #3a2b20;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dish-price {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a89484;
}

.dish-sub {
  font-size: 26rpx;
  font-weight: 600;
  color: #2f241d;
}

.total-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f4ece2;
}

.total-label {
  font-size: 24rpx;
  color: #8d7767;
  margin-right: 14rpx;
}

.total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef5a24;
}

.total-value .yuan {
  font-size: 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.info-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 23rpx;
  color: #a89484;
}

.info-value {
  flex: 1;
  font-size: 24rpx;
  color: #3a2b20;
  word-break: break-all;
}

.review-stars {
  font-size: 24rpx;
  color: #ff8a3d;
  letter-spacing: 2rpx;
}

.review-content {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #4d3c2f;
}

.review-link {
  margin-top: 16rpx;
  text-align: right;
  font-size: 22rpx;
  color: #a89484;
}

.bottom-gap {
  height: 170rpx;
}

.action-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 18rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(78, 51, 32, 0.07);
}

.btn {
  height: 82rpx;
  padding: 0 40rpx;
  margin-left: 16rpx;
  border-radius: 41rpx;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn.ghost {
  border: 1rpx solid #e2cdb9;
  color: #8a7361;
  background: #ffffff;
}

.btn.ghost.disabled {
  color: #c2b4a7;
  border-color: #eee4da;
}

.btn.primary {
  background: linear-gradient(135deg, #ff8659, #ef5a24);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(239, 90, 36, 0.26);
}

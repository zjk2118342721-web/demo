.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f2ec;
}

.content {
  flex: 1;
  overflow: hidden;
  padding-top: 20rpx;
}

.card {
  margin: 0 24rpx 20rpx;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(78, 51, 32, 0.05);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f241d;
}

.section-sub {
  font-size: 22rpx;
  color: #a89484;
}

.table-scroll {
  width: 100%;
  white-space: nowrap;
}

.table-list {
  display: inline-flex;
  padding-bottom: 6rpx;
}

.table-chip {
  width: 132rpx;
  margin-right: 16rpx;
  padding: 18rpx 0 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid #eee2d6;
  background: #fdf9f4;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.table-chip.active {
  border-color: #ef5a24;
  background: #fff2e8;
}

.table-chip.busy {
  opacity: 0.5;
}

.table-no {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a2b20;
}

.table-chip.active .table-no {
  color: #ef5a24;
}

.table-seats {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a89484;
}

.field-label {
  margin: 26rpx 0 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #3a2b20;
}

.remark {
  width: 100%;
  height: 140rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #faf5ee;
  font-size: 25rpx;
  line-height: 1.6;
  color: #4d3c2f;
}

.remark-placeholder {
  color: #b5a292;
}

.remark-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 20rpx;
  color: #b5a292;
}

.dish-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.dish-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0e5d8;
}

.dish-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.dish-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #3a2b20;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dish-qty {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a89484;
}

.dish-sub {
  font-size: 27rpx;
  font-weight: 600;
  color: #2f241d;
}

.total-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-top: 14rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f4ece2;
}

.total-label {
  font-size: 24rpx;
  color: #8d7767;
  margin-right: 14rpx;
}

.total-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #ef5a24;
}

.tip {
  margin: 0 34rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a89484;
}

.bottom-gap {
  height: 160rpx;
}

.submit-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(78, 51, 32, 0.07);
}

.submit-label {
  font-size: 22rpx;
  color: #a89484;
}

.submit-total {
  margin-top: 2rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ef5a24;
}

.submit-total .yuan {
  font-size: 24rpx;
}

.submit-btn {
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #ff8659, #ef5a24);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(239, 90, 36, 0.28);
}

.submit-btn.loading {
  opacity: 0.6;
}

.page {
  height: 100vh;
  background: #f7f2ec;
}

.content {
  height: 100%;
  overflow: hidden;
}

.profile-head {
  display: flex;
  align-items: center;
  padding: 36rpx 30rpx 76rpx;
  background: linear-gradient(160deg, #2b1a12 0%, #4a2c1e 62%, #6b3a22 100%);
}

.avatar-wrap {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #f6e3d4;
  border: 4rpx solid rgba(255, 255, 255, 0.24);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b5622f;
  font-size: 44rpx;
  font-weight: 700;
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.phone {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.edit-btn {
  padding: 10rpx 24rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  flex-shrink: 0;
}

.stats-card {
  position: relative;
  margin: -46rpx 24rpx 0;
  padding: 26rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  box-shadow: 0 12rpx 30rpx rgba(43, 26, 18, 0.12);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #2f241d;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a8776;
}

.menu-card {
  margin: 20rpx 24rpx 0;
  padding: 0 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(78, 51, 32, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f4ece2;
}

.menu-item.last {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #fff2e8;
  color: #c26b3a;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.menu-name {
  font-size: 27rpx;
  color: #3a2b20;
}

.menu-arrow {
  font-size: 30rpx;
  color: #c0af9f;
}

.reviews-section {
  margin: 20rpx 24rpx 0;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(78, 51, 32, 0.05);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f241d;
}

.section-sub {
  font-size: 22rpx;
  color: #a89484;
}

.review-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4ece2;
}

.review-card:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-order {
  font-size: 20rpx;
  color: #a89484;
  letter-spacing: 1rpx;
}

.review-stars {
  font-size: 22rpx;
  color: #ff8a3d;
  letter-spacing: 2rpx;
}

.review-dishes {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #b09c8b;
}

.review-content {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #4d3c2f;
}

.review-reply {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #faf3ea;
  color: #8a6a4f;
  font-size: 23rpx;
  line-height: 1.6;
}

.review-time {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #b5a292;
}

.empty-state.small {
  padding: 60rpx 0 40rpx;
}

.bottom-gap {
  height: 60rpx;
}

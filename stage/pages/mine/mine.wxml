<view class="page">
  <scroll-view class="content" scroll-y>
    <view class="profile-head">
      <view class="avatar-wrap">
        <image
          wx:if="{{avatarUrl}}"
          class="avatar-img"
          src="{{avatarUrl}}"
          mode="aspectFill"
          binderror="onAvatarError"
        ></image>
        <view wx:else class="avatar-text">{{avatarText}}</view>
      </view>
      <view class="profile-info">
        <view class="nickname">{{user.nickname || '微信用户'}}</view>
        <view class="phone">{{user.phone || '欢迎光临味食香'}}</view>
      </view>
      <view class="edit-btn" bindtap="editNickname">编辑资料</view>
    </view>

    <view class="stats-card">
      <view
        wx:for="{{stats}}"
        wx:key="status"
        class="stat"
        data-status="{{item.status}}"
        bindtap="goStat"
      >
        <view class="stat-num">{{item.count}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-item" bindtap="goOrders">
        <view class="menu-left">
          <view class="menu-icon">单</view>
          <text class="menu-name">我的订单</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="contactShop">
        <view class="menu-left">
          <view class="menu-icon">店</view>
          <text class="menu-name">联系商家</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item last" bindtap="about">
        <view class="menu-left">
          <view class="menu-icon">味</view>
          <text class="menu-name">关于味食香</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="reviews-section">
      <view class="section-head">
        <text class="section-title">我的评价</text>
        <text class="section-sub">{{reviews.length}} 条</text>
      </view>

      <block wx:if="{{reviews.length}}">
        <view wx:for="{{reviews}}" wx:key="id" class="review-card">
          <view class="review-head">
            <text class="review-order">{{item.orderNo}}</text>
            <text class="review-stars">{{item.stars}}</text>
          </view>
          <view class="review-dishes">{{item.dishNames}}</view>
          <view class="review-content">{{item.content || '未填写评价内容'}}</view>
          <view wx:if="{{item.reply}}" class="review-reply">商家回复：{{item.reply}}</view>
          <view class="review-time">{{item.timeText}}</view>
        </view>
      </block>

      <view wx:else class="empty-state small">
        <view class="empty-icon">评</view>
        <text>还没有评价，用餐后来说两句吧</text>
      </view>
    </view>

    <view class="bottom-gap"></view>
  </scroll-view>
</view>

page {
  min-height: 100vh;
  background: #f7f2ec;
  color: #2f241d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
input,
textarea,
scroll-view,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: none;
  line-height: normal;
  border-radius: 0;
}

button::after {
  border: none;
}

image {
  display: block;
}

.price {
  color: #e25422;
  font-weight: 700;
}

.price .yuan {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #a89484;
  font-size: 26rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0e5d8;
  color: #c9ad93;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-weight: 700;
}

.primary-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff8659, #ef5a24);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 26rpx rgba(239, 90, 36, 0.28);
}

.primary-btn[disabled] {
  opacity: 0.5;
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}
